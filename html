<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>LIYA - HAB Detector</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Montserrat:wght@700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #b2f5ea; margin: 0; overflow-x: hidden; }
        .liya-header { font-family: 'Montserrat', sans-serif; letter-spacing: 0.1em; }
        .bounding-box { position: absolute; border: 2px solid; pointer-events: none; z-index: 10; }
        .bounding-label { position: absolute; top: -20px; left: -2px; color: white; font-size: 8px; padding: 2px 4px; font-weight: bold; }
        .shutter-btn:active { transform: scale(0.9); }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="importmap">
{
  "imports": {
    "react": "https://esm.sh/react@18.2.0",
    "react-dom": "https://esm.sh/react-dom@18.2.0",
    "react-dom/": "https://esm.sh/react-dom@^19.2.4/",
    "react/": "https://esm.sh/react@^19.2.4/"
  }
}
</script>

    <script type="module">
        import React, { useState, useRef, useEffect, useCallback } from 'react';
        import ReactDOM from 'react-dom';

        const ROBOFLOW_API_KEY = "6JUDsfKEWcpncQBxqbfY";
        const MODEL_ENDPOINT = "https://detect.roboflow.com/liya-y6tnm/11";
        const CONFIDENCE_THRESHOLD = 0.50;

        const App = () => {
            const [view, setView] = useState('camera'); // camera | analyzing | result
            const [result, setResult] = useState(null);
            const [isFlashOn, setIsFlashOn] = useState(false);
            const videoRef = useRef(null);
            const canvasRef = useRef(null);

            // --- Camera Logic ---
            useEffect(() => {
                if (view === 'camera') {
                    navigator.mediaDevices.getUserMedia({ 
                        video: { facingMode: 'environment', width: 1280, height: 720 } 
                    }).then(stream => {
                        if (videoRef.current) videoRef.current.srcObject = stream;
                    });
                }
            }, [view]);

            const capture = async () => {
                const context = canvasRef.current.getContext('2d');
                canvasRef.current.width = videoRef.current.videoWidth;
                canvasRef.current.height = videoRef.current.videoHeight;
                context.drawImage(videoRef.current, 0, 0);
                const base64 = canvasRef.current.toDataURL('image/jpeg');
                
                setView('analyzing');
                await runInference(base64);
            };

            // --- AI Logic ---
            const runInference = async (base64) => {
                try {
                    const cleanBase64 = base64.split(',')[1];
                    const resp = await fetch(`${MODEL_ENDPOINT}?api_key=${ROBOFLOW_API_KEY}`, {
                        method: "POST",
                        body: cleanBase64,
                        headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    });
                    const data = await resp.json();
                    
                    const preds = (data.predictions || []).filter(p => p.confidence >= CONFIDENCE_THRESHOLD);
                    const best = preds.sort((a, b) => b.confidence - a.confidence)[0];
                    
                    // FIX: Check for healthy classes
                    const isHarmful = best && !['healthy', 'safe', 'normal', 'clean'].some(word => 
                        best.class.toLowerCase().includes(word)
                    );

                    setResult({
                        status: isHarmful ? 'Contaminated' : 'Safe',
                        bestClass: best ? best.class.toUpperCase() : 'CLEAR',
                        confidence: best ? best.confidence : 0.98,
                        image: base64,
                        preds: preds,
                        w: data.image.width,
                        h: data.image.height
                    });
                    setView('result');
                } catch (e) {
                    alert("Analysis Error. Check connection.");
                    setView('camera');
                }
            };

            return (
                <div className="max-w-md mx-auto min-h-screen bg-white shadow-xl relative flex flex-col">
                    {/* Header */}
                    <header className="p-4 flex justify-between items-center border-b border-cyan-100 bg-white sticky top-0 z-50">
                        <span className="text-xl">⚡</span>
                        <h1 className="liya-header text-3xl font-bold tracking-widest text-gray-900">LIYA</h1>
                        <span className="text-xl">☰</span>
                    </header>

                    {view === 'camera' && (
                        <div className="flex-1 flex flex-col p-4 gap-6">
                            <div className="relative aspect-[4/3] bg-black rounded-2xl overflow-hidden shadow-2xl">
                                <video ref={videoRef} autoPlay playsInline className="w-full h-full object-cover" />
                                <canvas ref={canvasRef} className="hidden" />
                            </div>
                            <div className="flex justify-center py-8">
                                <button onClick={capture} className="w-20 h-20 rounded-full border-4 border-gray-800 p-1 shutter-btn">
                                    <div className="w-full h-full bg-white rounded-full shadow-inner border-2 border-gray-100"></div>
                                </button>
                            </div>
                            <p className="text-center text-xs text-gray-400 font-bold uppercase tracking-widest">Center sample for AI analysis</p>
                        </div>
                    )}

                    {view === 'analyzing' && (
                        <div className="flex-1 flex flex-col items-center justify-center p-8 text-center bg-white">
                            <div className="w-16 h-16 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin mb-6"></div>
                            <h2 className="text-2xl font-bold text-gray-800 animate-pulse">LIYA IS ANALYZING...</h2>
                            <p className="text-gray-500 mt-2">Checking for HAB indicators using YOLOv11</p>
                        </div>
                    )}

                    {view === 'result' && result && (
                        <div className="flex-1 overflow-y-auto animate-in fade-in duration-500">
                            <div className="relative aspect-[4/3] bg-black">
                                <img src={result.image} className="w-full h-full object-cover" />
                                {result.preds.map((p, i) => (
                                    <div key={i} className="bounding-box" style={{
                                        borderColor: result.status === 'Contaminated' ? '#ef4444' : '#10b981',
                                        left: `${((p.x - p.width/2)/result.w)*100}%`,
                                        top: `${((p.y - p.height/2)/result.h)*100}%`,
                                        width: `${(p.width/result.w)*100}%`,
                                        height: `${(p.height/result.h)*100}%`
                                    }}>
                                        <div className="bounding-label" style={{ background: result.status === 'Contaminated' ? '#ef4444' : '#10b981' }}>
                                            {result.status === 'Contaminated' ? 'HABS' : 'HEALTHY'}: {p.class.toUpperCase()}
                                        </div>
                                    </div>
                                ))}
                            </div>
                            
                            <div className="p-6 space-y-6">
                                <div className="text-center">
                                    <div className={`inline-block px-10 py-2 rounded-full border-2 font-black text-2xl mb-2 ${
                                        result.status === 'Contaminated' ? 'bg-red-50 border-red-200 text-red-600' : 'bg-emerald-50 border-emerald-200 text-emerald-600'
                                    }`}>
                                        {result.status.toUpperCase()}
                                    </div>
                                    <p className="text-gray-400 text-[10px] font-bold tracking-widest uppercase">Confidence Score: {(result.confidence*100).toFixed(1)}%</p>
                                </div>

                                <div className="bg-gray-50 p-4 rounded-2xl border border-gray-100">
                                    <p className="font-bold text-gray-800 flex items-center gap-2">
                                        {result.status === 'Contaminated' ? '🚫' : '✅'} {result.bestClass}
                                    </p>
                                    <p className="text-xs text-gray-600 mt-2 italic">
                                        {result.status === 'Contaminated' 
                                          ? "Specimen flagged by LIYA YOLOv11. High risk of HAB contamination."
                                          : "Specimen appears healthy. LIYA model found no harmful indicators."}
                                    </p>
                                </div>

                                <button onClick={() => setView('camera')} className="w-full bg-black text-white py-4 rounded-2xl font-bold tracking-widest text-sm shadow-xl">
                                    RESCAN SAMPLE
                                </button>
                            </div>
                        </div>
                    )}

                    <footer className="p-4 bg-cyan-50 text-center border-t border-cyan-100">
                         <p className="text-[10px] font-bold text-gray-400">LIYA | AI-POWERED FISHERY MONITORING</p>
                    </footer>
                </div>
            );
        };

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>
